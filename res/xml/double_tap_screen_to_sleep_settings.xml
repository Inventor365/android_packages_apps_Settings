<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="double_tap_screen_to_sleep"
    android:title="@string/double_tap_screen_to_sleep_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="gesture_double_tap_screen_to_sleep_video"
        settings:searchable="false"
        settings:lottie_rawRes="@raw/lottie_tap_to_sleep"/>

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="gesture_double_tap_screen_to_sleep"
        android:title="@string/double_tap_screen_to_sleep_title"
        android:summary="@string/double_tap_screen_to_sleep_summary"
        settings:keywords="@string/keywords_double_tap_screen_to_sleep"
        settings:controller="com.android.settings.gestures.DoubleTapScreenToSleepPreferenceController" />

</PreferenceScreen>
