<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/tricky_store_title">

    <org.neoteric.preference.SystemSettingMainSwitchPreference
        android:key="spoof_trickystore_enabled"
        android:title="@string/tricky_store_title"
        android:summary="@string/tricky_store_summary"
        android:defaultValue="true" />

    <PreferenceCategory
        android:key="ts_keybox_category"
        android:title="@string/ts_keybox_management"
        android:dependency="spoof_trickystore_enabled">

        <Preference
            android:key="ts_import_keybox"
            android:title="@string/ts_import_keybox"
            android:summary="@string/ts_no_keybox" />

        <Preference
            android:key="ts_delete_keybox"
            android:title="@string/ts_delete_keybox"
            android:summary="@string/ts_delete_keybox_summary" />

        <Preference
            android:key="ts_revocation_status"
            android:title="@string/ts_revocation_status"
            android:summary="@string/ts_revocation_no_keybox"
            android:icon="@drawable/ic_ts_status_unknown" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_rkp_category"
        android:title="@string/ts_rkp_title"
        android:dependency="spoof_trickystore_enabled">

        <androidx.preference.SwitchPreferenceCompat
            android:key="ts_rkp_enabled"
            android:title="@string/ts_rkp_enabled"
            android:summary="@string/ts_rkp_enabled_summary"
            android:persistent="false" />

        <Preference
            android:key="ts_rkp_provision"
            android:title="@string/ts_rkp_provision"
            android:summary="@string/ts_rkp_provision_summary" />

        <Preference
            android:key="ts_rkp_status"
            android:title="@string/ts_rkp_status"
            android:summary="@string/ts_rkp_unavailable"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_target_category"
        android:title="@string/ts_target_configuration"
        android:dependency="spoof_trickystore_enabled">

        <Preference
            android:key="ts_manage_targets"
            android:title="@string/ts_manage_target_apps"
            android:summary="@string/ts_no_targets"
            android:fragment="com.android.settings.custom.spoofing.TrickyStoreAppSettings" />

        <Preference
            android:key="ts_import_targets"
            android:title="@string/ts_import_target_list"
            android:summary="@string/ts_import_target_list_summary" />

        <Preference
            android:key="ts_verification_mode"
            android:title="@string/ts_verification_mode"
            android:summary="@string/ts_verification_mode_auto"
            android:enabled="false"
            android:selectable="false" />

        <Preference
            android:key="ts_security_patch"
            android:title="@string/ts_security_patch"
            android:summary="@string/ts_no_patch" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="ts_footer_category"
        android:title="@string/ts_footer_title">

        <com.android.settingslib.widget.FooterPreference
            android:key="ts_footer"
            android:title="@string/ts_footer_body"
            android:selectable="false" />
    </PreferenceCategory>

</PreferenceScreen>
