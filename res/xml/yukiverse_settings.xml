<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="yukiverse_settings"
    android:title="@string/yukiverse_title">

    <com.android.settingslib.widget.CardPreference
        android:key="spoofing_settings"
        android:title="@string/spoof_settings_title"
        android:summary="@string/spoof_settings_summary"
        android:icon="@drawable/ic_spoof_settings"
        android:order="1"
        android:fragment="com.android.settings.custom.spoofing.SpoofingSettings" />

    <com.android.settingslib.widget.CardPreference
        android:key="yukiverse_system_settings"
        android:title="@string/yukiverse_system_title"
        android:summary="@string/yukiverse_system_summary"
        android:icon="@drawable/ic_yukiverse_system"
        android:order="2"
        android:fragment="com.android.settings.custom.yukiverse.YukiVerseSystemSettings" />

    <com.android.settingslib.widget.CardPreference
        android:key="yukiverse_launcher_settings"
        android:title="@string/yukiverse_launcher_title"
        android:summary="@string/yukiverse_launcher_summary"
        android:icon="@drawable/ic_yukiverse_launcher"
        android:order="3"
        android:fragment="com.android.settings.custom.yukiverse.YukiVerseLauncherSettings" />

</PreferenceScreen>
